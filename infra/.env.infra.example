# Copy this file to .env.infra and fill in real values.
# .env.infra is gitignored — never commit real secrets.
#
# Usage:
#   cp infra/.env.infra.example infra/.env.infra
#   # edit infra/.env.infra with real values
#   set -a; source infra/.env.infra; set +a
#   ./infra/bootstrap.sh

# GitHub PAT with repo access - used by Backstage's GitHub integration
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub OAuth App (Settings > Developer settings > OAuth Apps) used for
# Backstage sign-in
AUTH_GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
AUTH_GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password for the 'backstage' PostgreSQL user/database
BACKSTAGE_DB_PASSWORD=change-me

# Optional - defaults to admin123 if unset
GRAFANA_ADMIN_PASSWORD=admin123
